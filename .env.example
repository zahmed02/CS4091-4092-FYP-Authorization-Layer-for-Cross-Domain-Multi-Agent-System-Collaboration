# ---- shared template; copy per-domain into infra/docker/domain-a.env and domain-b.env ----
TRUST_DOMAIN_ID=domain-a
DATABASE_URL=postgresql+asyncpg://authlayer:changeme_a@postgres-domain-a:5432/authlayer_domain_a
REDIS_URL=redis://redis-domain-a:6379/0
JWT_ALGORITHM=EdDSA
JWT_PRIVATE_KEY_PATH=./keys/domain-a-private.pem
JWT_PUBLIC_KEY_PATH=./keys/domain-a-public.pem
LOG_LEVEL=INFO
